{
  "name": "tiny-flex-workspace",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm --filter tiny-flex build",
    "demo": "pnpm --filter @tiny-flex/demo dev",
    "test": "pnpm --filter @tiny-flex/test test",
    "format": "prettier --write './{apps,packages}/**/*.{ts,html,json}' './*.{json,md,yaml,yml}'",
    "format:check": "prettier --check './{apps,packages}/**/*.{ts,html,json}' './*.{json,md,yaml,yml}'"
  },
  "devDependencies": {"prettier": "catalog:"},
  "engines": {"node": "24", "pnpm": "11"},
  "packageManager": "pnpm@11.0.0"
}
